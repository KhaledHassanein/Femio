{
  "name": "femio",
  "version": "0.0.0",
  "private": true,
  "description": "Femio — a private women's-health app (Flutter) and its static front-door website (Next.js).",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm claims-lint && pnpm wordmark-lint && pnpm crisis-lint && pnpm analytics-lint && pnpm content-lint && pnpm i18n-client-lint && pnpm i18n-untranslated-lint && pnpm tokens-parity-lint && pnpm tokens-dart-lint && pnpm mobile-vocab-lint && pnpm native-readiness-lint && pnpm chart-literals-lint && pnpm content-build-lint",
    "claims-lint": "node scripts/claims-lint.mjs",
    "crisis-lint": "node scripts/crisis-compliance.mjs",
    "analytics-lint": "node scripts/analytics-lint.mjs",
    "i18n-client-lint": "node scripts/i18n/client-namespaces-lint.mjs",
    "i18n-untranslated-lint": "node scripts/i18n/untranslated-lint.mjs",
    "tokens-parity-lint": "node scripts/design/tokens-parity-lint.mjs",
    "tokens-dart-lint": "node scripts/design/tokens-to-dart.mjs --check",
    "mobile-vocab-lint": "node --experimental-strip-types --no-warnings scripts/mobile/sync-log-vocabulary.mjs --check",
    "native-readiness-lint": "node scripts/native-readiness-lint.mjs",
    "chart-literals-lint": "node scripts/chart-literals-lint.mjs",
    "content-lint": "node scripts/content-lint.mjs",
    "content-lint:urls": "node scripts/content-lint.mjs --check-urls",
    "sitemap-check": "node scripts/seo/sitemap-check.mjs",
    "content-lint:test": "node scripts/content-lint.test.mjs",
    "audit": "pnpm audit --audit-level high",
    "gate:mobile": "cd apps/mobile && flutter analyze && flutter test",
    "brand:icons": "node scripts/brand/generate-icons.mjs",
    "docs:html": "node scripts/docs/md-to-html.mjs",
    "content:build": "node scripts/content/build-content.mjs",
    "content-build-lint": "node scripts/content/build-content.mjs --check",
    "wordmark-lint": "node scripts/wordmark-lint.mjs"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "marked": "14.0.0"
  }
}
