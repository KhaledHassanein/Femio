# Postgres connection string — Supabase dashboard → Settings → Database →
# Connection string → "Session pooler" (or URI). Payload needs a direct/session
# connection (not the transaction pooler) so it can manage schema.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random secret for Payload auth/session signing. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string
