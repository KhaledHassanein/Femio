{
  "name": "cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Femio content CMS — Payload 3 on the shared Supabase Postgres.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "set-roles": "payload run ./scripts/set-user-roles.mjs",
    "generate:importmap": "payload generate:importmap",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:apply": "node ./scripts/migrate-apply.mjs",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "graphql": "^16.9.0",
    "next": "^16.3.8",
    "payload": "^3.90.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.3"
  }
}
