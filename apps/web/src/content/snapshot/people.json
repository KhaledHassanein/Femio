                  "version": 1
                }
              ],
              "direction": "ltr",
              "textFormat": 0
            },
            {
              "type": "paragraph",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "mode": "normal",
                  "text": "محتوى في الصحة والعافية يشمل صحة الدورة الشهرية والخصوبة والحمل وانقطاع الطمث. ويتركز العمل على جعل الموضوعات المعقدة واضحة وعملية ومحترمة، مع الحرص على توثيق المصادر ووضوح حدود السلامة. ويدعم محتوى femio الوعي الشخصي والحوار المستنير مع المختصين المؤهلين في الرعاية الصحية، ولا يغني عن المشورة الطبية الفردية.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
                }
              ],
              "direction": "ltr",
              "textFormat": 0
            }
