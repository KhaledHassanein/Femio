                  "mode": "normal",
                  "text": "Dr. Khaled contributes to Femio’s evidence-informed health and wellness content, focusing on clear, practical, and carefully sourced information.",
                  "type": "text",
                  "style": "",
                  "detail": 0,
                  "format": 0,
                  "version": 1
