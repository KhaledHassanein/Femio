# Copy to .env.local and fill in. .env.local is gitignored.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (EU region). The publishable key (sb_publishable_…) is client-safe and
# protected by Row-Level Security; it is fine to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only secret key for trusted admin/RPC operations (added later — P1.18+).
# NEVER prefix with NEXT_PUBLIC_. Keep out of the client bundle and out of git.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Private-beta signup gate (P0.12.5). UNSET = signup is open, exactly as today.
# Set it to any string and /welcome requires that code plus shows the beta notice.
# Deliberately NOT a security control — it is NEXT_PUBLIC and readable in the
# bundle. It stops a stranger arriving from a search result storing real health
# data while the privacy policy is still a draft; the real control is P0.12.
NEXT_PUBLIC_BETA_INVITE_CODE=

# Payload CMS origin. Without it /learn, /conditions and /glossary render their
# empty state locally while production serves real articles — so UI work on any
# content page is done blind. Point it at the deployed CMS unless you are running
# apps/cms locally (docs/26 §8).
NEXT_PUBLIC_CMS_URL=https://femio-cms.vercel.app
