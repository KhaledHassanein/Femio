# The assistant's Firebase config (ADR-078). Copy to assistant.env (git-ignored) and fill in the
# values from the Firebase console: Project settings > Your apps > Android app com.femioapp.femio.
# These ids identify the app to Firebase; App Check, not secrecy, is what protects the quota.
# Without this file the assistant reports "not configured" and every feature runs on rules.
FEMIO_FIREBASE_APP_ID=
FEMIO_FIREBASE_API_KEY=
FEMIO_FIREBASE_PROJECT_ID=
# The cloud model for grounded answers (paid tier only). Gemini 3.5 Flash-Lite is the cheapest.
FEMIO_AI_CLOUD_MODEL=gemini-3.5-flash-lite
