<?xml version="1.0" encoding="utf-8"?>
<!-- The release build shrinks unused resources. The reminder icon is only named from Dart
     at run time, so it must be kept or reminders would silently fail to show. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_femio,@mipmap/ic_launcher" />
