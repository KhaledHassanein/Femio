<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's rounded plum ground: token plum-800 to plum-600, rounded corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/widget_ground_start"
        android:endColor="@color/widget_ground_end" />
    <corners android:radius="@dimen/widget_corner" />
</shape>
