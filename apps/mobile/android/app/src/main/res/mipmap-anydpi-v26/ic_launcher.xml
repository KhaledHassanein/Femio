<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+): the Bloom foreground over a plum-900
     background. Both layers come from scripts/brand/generate-icons.mjs; the
     legacy ic_launcher.png in each mipmap folder serves older devices. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
