# Office lock/temp files
~$*

# Playwright storage state written by scripts/dev/seed-and-shoot.mjs during
# debugging. It holds a live Supabase session cookie for a throwaway anonymous
# user — short-lived and RLS-bound, but a session credential all the same, and
# credentials do not belong in a repo. One was committed by accident and has since
# been purged from history; the SHAs that carried it no longer exist.
.seeded-state.json
**/.seeded-state.json
screenshots/
# The Play Store images are a deliverable, rendered by apps/mobile/test/store_screenshots_test.dart
# from the real screens with synthetic data; they are tracked so the listing can be rebuilt.
!docs/store/screenshots/

# Per-runtime agent tooling. `.agents/skills` is a mirror of `.claude/skills`,
# which is tracked (70 files) — committing both would be 3.7MB of near-duplicate
# that drifts silently, since the two copies already differ. `.codex/config.toml`
# is one person's local tool config, not a build input.
.agents/
.codex/

# Python bytecode (the ui-ux-pro-max search script)
__pycache__/
*.pyc

# Growth-ops raw exports (owner drops; never committed)
docs/34_GROWTH_OPS/reports/play/
docs/34_GROWTH_OPS/reports/gsc/
docs/34_GROWTH_OPS/reports/ga4/
# Playwright MCP output (screenshots, snapshots, console logs); evidence is copied into testing-results/
.playwright-mcp/
